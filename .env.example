# MongoDB local ou distant
MONGODB_URI=mongodb://127.0.0.1:27017/mythos_ai
PORT=3000

# mock (fonctionne sans service IA) ou ollama
AI_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=60000

# Remplacer par une longue valeur aléatoire et privée
JWT_KEY=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
